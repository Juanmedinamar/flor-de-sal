# Configuración de despliegue para Flor de Sal
# Copia este archivo a .env y edita los valores

# Dominio público (para nginx + Let's Encrypt)
DOMAIN=salina.tudominio.com
EMAIL_LETSENCRYPT=tu-email@tudominio.com

# Zona horaria de la salina (para 'línea ahora', fechas, etc.)
TIMEZONE=Europe/Madrid

# Puerto interno de Streamlit (no cambiar salvo conflicto)
STREAMLIT_PORT=8501

# Configuración de base de datos (ruta dentro del contenedor)
DB_PATH=/app/data/flor_desal.db

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Archivo de log (dentro del contenedor, montado en volumen backups/logs)
LOG_FILE=/app/logs/app.log

# Para desarrollo local sin nginx (opcional)
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_PORT=8501